---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../../../../layouts/Layout.astro";
import {
  getBlogParams,
  getPubDate,
  getUpdatedDate,
} from "../../../../../utils/params";
import TopicBadge from "../../../../../components/blog/TopicBadge.astro";
import AuthorBio from "../../../../../components/blog/AuthorBio.astro";
import { blog as blogBranding } from "../../../../../config/data.json";

export const getStaticPaths = async () => {
  const blogs = await getCollection("blog");
  return blogs.map(blog => ({
    params: getBlogParams(blog),
    props: { blog },
  }));
};

type Props = { blog: CollectionEntry<"blog"> };

const { blog } = Astro.props;
const { Content } = await render(blog);

const wordCount = blog.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));
const updatedDate = getUpdatedDate(blog);
---

<Layout
  title={`${blog.data.title} — ${blogBranding.name}`}
  description={blog.data.description}
  image={`/og/${blog.id.replace(/\.[^/.]+$/, "")}.png`}
  type="article"
>
  <!-- Dark journal header -->
  <div
    class="relative overflow-hidden pt-28 pb-16"
    style="background-color: #1d2b3e;"
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-10"
      style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 32px 32px;"
    ></div>
    <div class="relative z-10 mx-auto max-w-3xl px-6">
      <!-- Breadcrumb -->
      <a
        href="/blog"
        class="font-label text-secondary inline-flex items-center gap-2 text-sm font-bold tracking-widest uppercase transition-opacity hover:opacity-70"
      >
        ← {blogBranding.name}
      </a>

      <!-- Topics -->
      {blog.data.topics.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {blog.data.topics.map((t: string) => (
            <TopicBadge topic={t} variant="pill-md" />
          ))}
        </div>
      )}

      <!-- Title -->
      <h1 class="mt-4 text-4xl leading-tight font-black tracking-tighter text-white md:text-5xl">
        {blog.data.title}
      </h1>

      <!-- Meta -->
      <div class="mt-4 flex items-center gap-4 font-mono text-sm text-white/50">
        <time datetime={getPubDate(blog).toISOString()}>
          {getPubDate(blog).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        <span class="h-1 w-1 rounded-full bg-white/30"></span>
        <span>{readingTime} min read</span>
        {updatedDate && (
          <>
            <span class="h-1 w-1 rounded-full bg-white/30" />
            <time
              datetime={updatedDate.toISOString()}
              class="text-white/70 italic"
            >
              Updated{" "}
              {updatedDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          </>
        )}
      </div>
    </div>
  </div>

  <!-- Article body -->
  <div class="bg-surface pb-20">
    <div class="mx-auto max-w-3xl px-6 pt-12">
      <article class="space-y-8">
        <!-- Content -->
        <div id="markdown" class="prose prose-lg max-w-none">
          <Content />
        </div>

        <!-- Share footer -->
        <div
          class="flex items-center gap-2 pt-8"
          style="border-top: 1px solid var(--color-surface-container-high);"
        >
          <span class="font-label text-outline mr-1 shrink-0 text-xs tracking-widest uppercase">
            Share:
          </span>
          <div class="flex flex-wrap gap-2">
            <a
              id="share-mastodon"
              href="https://mastodonshare.com"
              target="_blank"
              rel="noopener noreferrer"
              class="font-label text-on-surface-variant hover:text-secondary border-outline-variant border px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors"
            >
              Mastodon
            </a>
            <a
              id="share-linkedin"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="font-label text-on-surface-variant hover:text-secondary border-outline-variant border px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors"
            >
              LinkedIn
            </a>
            <a
              id="share-bluesky"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="font-label text-on-surface-variant hover:text-secondary border-outline-variant border px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors"
            >
              Bluesky
            </a>
            <a
              id="share-x"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="font-label text-on-surface-variant hover:text-secondary border-outline-variant border px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors"
            >
              X
            </a>
            <button
              id="share-copy"
              class="font-label text-on-surface-variant hover:text-secondary border-outline-variant border px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors"
            >
              Copy link
            </button>
          </div>
        </div>

        <!-- Author bio -->
        <AuthorBio variant="post" />
      </article>
    </div>
  </div>
</Layout>

<script>
  const url = encodeURIComponent(window.location.href);
  const text = encodeURIComponent(document.title);

  const mastodon = document.getElementById(
    "share-mastodon"
  ) as HTMLAnchorElement;
  if (mastodon)
    mastodon.href = `https://mastodonshare.com/?text=${text}&url=${url}`;

  const linkedin = document.getElementById(
    "share-linkedin"
  ) as HTMLAnchorElement;
  if (linkedin)
    linkedin.href = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;

  const bluesky = document.getElementById("share-bluesky") as HTMLAnchorElement;
  if (bluesky)
    bluesky.href = `https://bsky.app/intent/compose?text=${text}%20${decodeURIComponent(url)}`;

  const x = document.getElementById("share-x") as HTMLAnchorElement;
  if (x) x.href = `https://x.com/intent/tweet?url=${url}&text=${text}`;

  document.getElementById("share-copy")?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(window.location.href);
    const btn = document.getElementById("share-copy");
    if (btn) {
      btn.textContent = "Copied!";
      setTimeout(() => (btn.textContent = "Copy link"), 2000);
    }
  });

  // Heading anchor links: hovering a heading reveals a link icon; clicking it
  // jumps to the section and copies the deep-link URL to the clipboard.
  const linkIcon = `<svg class="anchor-link-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`;
  const checkIcon = `<svg class="anchor-check" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;

  for (const heading of document.querySelectorAll<HTMLElement>(
    "#markdown :is(h1, h2, h3, h4, h5, h6)[id]"
  )) {
    const anchor = document.createElement("a");
    anchor.href = `#${heading.id}`;
    anchor.className = "anchor-link";
    anchor.setAttribute(
      "aria-label",
      `Copy link to section “${heading.textContent?.trim()}”`
    );
    anchor.innerHTML = linkIcon + checkIcon;
    anchor.addEventListener("click", () => {
      navigator.clipboard.writeText(anchor.href).then(() => {
        anchor.classList.add("copied");
        setTimeout(() => anchor.classList.remove("copied"), 2000);
      });
    });
    heading.prepend(anchor);
  }
</script>

<style is:global>
  /* Heading anchor links in the blog post body */
  #markdown :is(h1, h2, h3, h4, h5, h6)[id] {
    position: relative;
    scroll-margin-top: 5rem;
  }

  #markdown .anchor-link {
    position: absolute;
    top: 50%;
    left: -1.75rem;
    display: inline-flex;
    transform: translateY(-50%);
    color: var(--color-outline);
    opacity: 0;
    transition:
      opacity 150ms ease,
      color 150ms ease;
  }

  #markdown :is(h1, h2, h3, h4, h5, h6)[id]:hover .anchor-link,
  #markdown .anchor-link:focus-visible {
    opacity: 1;
  }

  #markdown .anchor-link:hover {
    color: var(--color-secondary);
  }

  #markdown .anchor-link .anchor-check {
    display: none;
  }

  #markdown .anchor-link.copied .anchor-check {
    display: block;
  }

  #markdown .anchor-link.copied .anchor-link-icon {
    display: none;
  }

  /* Touch devices have no hover: hide the anchor to avoid invisible tap targets */
  @media (hover: none) {
    #markdown .anchor-link {
      display: none;
    }
  }
</style>
